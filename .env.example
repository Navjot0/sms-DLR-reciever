# Copy to .env and adjust. docker compose reads .env automatically.
DB_PASSWORD=dlr
POSTGRES_PORT=5432
DLR_PORT=8080
DLR_LB_PORT=8081

# Callback authentication (off for local automation; required with SPRING_PROFILES_ACTIVE=prod)
DLR_AUTH_ENABLED=false
DLR_API_KEY_ENABLED=false
DLR_API_KEYS=
DLR_HMAC_ENABLED=false
DLR_HMAC_SECRET=

# Meta (WhatsApp) callback URL verification token (hub.verify_token)
DLR_META_VERIFY_TOKEN=

# Automatic clean-up: data older than this many days is deleted (DLR_RETENTION_ENABLED=false to keep everything)
DLR_RETENTION_ENABLED=true
DLR_RETENTION_DAYS=7
